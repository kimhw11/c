#pragma warning (disable : 4996)
#include <stdio.h>

int main()
{
    int N;
    scanf("%d", &N);

    int ce = 0, sw = 0, ds = 0;
    int ce_ok = 0, sw_ok = 0, ds_ok = 0;
    int flag = 1;


    for (int i = 0;i < N;i++)
    {   
        int x;
        scanf("%d", &x);

        int a = x / 10000;
        int b = (x / 1000) % 10;
        int c = (x / 100) % 10;

        if (x < 10000 || x>99999 || x % 100 != 0 || (a == b && b == c && c == a) || (a != b && b != c && a != c))
        {
            printf("none\n");
            flag = 0;
            continue;
        }

        else
        {
            if (c == 0 || c == 1 || c == 2)
            {
                if (flag == 1) {
                    printf("CE\n");
                    ce++;
                    ce_ok++;
                    flag = 1;
                }
                else {
                    printf("CE\n");
                    ce++;
                    flag = 1;
                }
            }

            else if (c == 3 || c == 4)
            {
                if (flag == 1) {
                    printf("SW\n");
                    sw++;
                    sw_ok++;
                    flag = 1;
                }
                else {
                    printf("SW\n");
                    sw++;
                    flag = 1;
                }
            }

            else if (c == 5)
            {
                if (flag == 1) {
                    printf("DS\n");
                    ds++;
                    ds_ok++;
                    flag = 1;
                }
                else {
                    printf("DS\n");
                    ds++;
                    flag = 1;
                }
            }

            else
            {
                printf("none\n");
            }
        }
    }

    printf("%d %d %d\n", ce, sw, ds);
    printf("%d %d %d\n", ce_ok, sw_ok, ds_ok);


    return 0;
}

