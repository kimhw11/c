#pragma warning (disable : 4996)
#include <stdio.h>

int main() {
	int n;
	scanf("%d", &n);

	if (n % 2 == 0 && n % 3 == 0 && n % 5 == 0) {
		printf("%d %d %d", 2,3,5);
	}

	else if (n % 2 == 0 && n % 3 == 0 && n % 5 != 0) {
		printf("%d %d", 2,3);
	}

	else if (n % 2 == 0 && n % 3 != 0 && n % 5 == 0) {
		printf("%d %d", 2, 5);
	}

	else if (n % 2 != 0 && n % 3 == 0 && n % 5 == 0) {
		printf("%d %d", 3,5);
	}

	else if (n % 2 == 0 && n % 3 != 0 && n % 5 != 0) {
		printf("%d" ,2);
	}

	else if (n % 2 != 0 && n % 3 == 0 && n % 5 != 0) {
		printf("%d", 3);
	}

	else if (n % 2 != 0 && n % 3 != 0 && n % 5 == 0) {
		printf("%d", 5);
	}

	else {
		printf("N");
	}
}
