#pragma warning (disable : 4996)
#include <stdio.h>

int main() {
	char s;
	int n;
	scanf("%c %d", &s, &n);

	if (s >= 'a' && s <= 'z') {
		if (n + s > 'z') {
			n = (n + s) % 'z' - 1;
			printf("%c", 'a' + n);
		}
		
		else {
			printf("%c", n + s);
		}
	}

	else if (s >= 'A' && s <= 'Z') {
		if (n + s > 'Z') {
			n = (n + s) % 'Z' - 1;
			printf("%c", 'A' + n);
		}

		else {
			printf("%c", n + s);
		}
	}

	else {
		printf("%c", s);
	}
}
