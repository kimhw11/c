#pragma warning (disable : 4996)
#include <stdio.h>

int main() {
	int a,b,c,d,e;
	double avg = 0;

	scanf("%d %d %d %d %d", &a,&b,&c,&d,&e);

	avg = (a + b + c + d + e) / 5.0;

	if (avg >= 85) {
		printf("A\n");
	}

	else if (avg >= 70) {
		printf("B\n");
	}

	else {
		printf("F\n");
	}

	printf("%.2lf", avg);
}
